<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.dinevista.model.EventBookingRecord,java.util.List" %>
<% request.setAttribute("pageTitle","Event Bookings"); request.setAttribute("activeNav","staffEventBookings"); List<EventBookingRecord> bs=(List<EventBookingRecord>)request.getAttribute("eventBookings"); String ctx=request.getContextPath(); %>
<%@ include file="fragments/header.jspf" %>
<section class="section-sm"><div class="container"><div class="section-heading"><div><span class="section-kicker">Event operations</span><h1>Event bookings</h1></div><a class="btn btn-primary" href="<%=ctx%>/staff/event-packages">Manage packages</a></div>
<form method="get" class="search-bar"><input class="form-control" name="search" placeholder="Reference, customer, package or status..." value="<%=com.dinevista.util.HtmlUtil.escape(String.valueOf(request.getParameter("search")==null?"":request.getParameter("search")))%>"><button class="btn btn-secondary">Search</button></form>
<div class="table-wrap"><table class="data-table"><thead><tr><th>Reference</th><th>Customer</th><th>Package</th><th>Date/time</th><th>Guests</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody><%for(EventBookingRecord b:bs){%><tr><td><strong><%=b.getReference()%></strong></td><td><%=com.dinevista.util.HtmlUtil.escape(b.getCustomerName())%><br><small><%=com.dinevista.util.HtmlUtil.escape(b.getEmail())%></small></td><td><%=com.dinevista.util.HtmlUtil.escape(b.getPackageName())%></td><td><%=b.getEventDate()%><br><%=b.getEventTime()%></td><td><%=b.getGuestCount()%></td><td>LKR <%=b.getTotalAmount()%></td><td><%=b.getStatus()%></td><td><a class="btn btn-secondary btn-sm" href="<%=ctx%>/staff/event-bookings/view?reference=<%=b.getReference()%>">Review</a></td></tr><%}%></tbody></table></div></div></section><%@ include file="fragments/footer.jspf" %>
