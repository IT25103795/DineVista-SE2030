<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.dinevista.model.EventPackageRecord" %>
<% request.setAttribute("pageTitle","Event Package Details"); request.setAttribute("activeNav","staffEventPackages"); EventPackageRecord p=(EventPackageRecord)request.getAttribute("eventPackage"); String ctx=request.getContextPath(); %>
<%@ include file="fragments/header.jspf" %>
<section class="section-sm"><div class="container"><div class="section-heading"><div><span class="section-kicker">Package details</span><h1><%=com.dinevista.util.HtmlUtil.escape(p.getName())%></h1></div><span class="status-badge"><%=p.isActive()?"ACTIVE":"INACTIVE"%></span></div>
<div class="detail-card"><div class="detail-grid"><div><span>Category</span><strong><%=p.getCategory()%></strong></div><div><span>Price</span><strong>LKR <%=p.getPricePerGuest()%> / guest</strong></div><div><span>Capacity</span><strong><%=p.getMinimumGuests()%> - <%=p.getMaximumGuests()%> guests</strong></div><div><span>Duration</span><strong><%=p.getDurationMinutes()/60%>h <%=p.getDurationMinutes()%60%>m</strong></div></div><p style="margin-top:24px"><%=com.dinevista.util.HtmlUtil.escape(p.getDescription())%></p><h3>Inclusions</h3><p><%=com.dinevista.util.HtmlUtil.escape(p.getInclusions())%></p></div>
<div class="form-actions" style="margin-top:20px"><a class="btn btn-primary" href="<%=ctx%>/staff/event-packages/edit?id=<%=p.getId()%>">Edit</a><%if(p.isActive()){%><form method="post" action="<%=ctx%>/staff/event-packages/deactivate"><input type="hidden" name="id" value="<%=p.getId()%>"><button class="btn btn-secondary" type="submit">Deactivate</button></form><%}else{%><form method="post" action="<%=ctx%>/staff/event-packages/delete"><input type="hidden" name="id" value="<%=p.getId()%>"><button class="btn btn-secondary" type="submit">Delete permanently</button></form><%}%><a class="btn btn-secondary" href="<%=ctx%>/staff/event-packages">Back</a></div></div></section><%@ include file="fragments/footer.jspf" %>
